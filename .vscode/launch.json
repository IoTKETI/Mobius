{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Mobius",
            "program": "${workspaceFolder}/mobius.js",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "command": "npm start",
            "name": "Run via npm",
            "request": "launch",
            "type": "node-terminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Mobius (MySQL)",
            "program": "${workspaceFolder}/mobius.js",
            "args": [
                "mysql"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Mobius (SQLite)",
            "program": "${workspaceFolder}/mobius.js",
            "args": [
                "sqlite"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}