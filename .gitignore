# Dependency directories
.gitignore
node_modules/
.idea/
log/
doc/
# docs/ 는 배포본 PDF 등을 막기 위한 것이다. 다만 설계 문서(스펙)는 저장소에 남긴다.
# 디렉터리 자체를 제외하면 하위를 되살릴 수 없으므로 docs/* 로 내용만 제외한다.
docs/*
!docs/superpowers/
# 동등성 스냅샷은 로컬 산출물이다 (.gitkeep 은 남긴다)
tools/equivalence/out/*
!tools/equivalence/out/.gitkeep
tools/golden/out/*
!tools/golden/out/.gitkeep
hit.json
cbs_cache.json
package-lock.json
ss_ri_cache.json
conf.json
*.drawio
mobius.db*
test_*
.vscode/

# Claude Code (개인 설정/메모리)
.claude/
CLAUDE.md
.superpowers/

# SSH 키 — 절대 커밋되면 안 된다.
# (*.pem 은 넣지 않는다. ca-crt.pem / server-crt.pem / server-key.pem 은
#  이미 추적 중이라 넣어 봐야 적용되지 않고, 나중에 지웠다 되돌릴 때
#  조용히 무시되는 함정만 만든다.)
id_ed25519
id_ed25519.pub
id_rsa
id_rsa.pub
*.ppk
