# Dependency directories
.gitignore
node_modules/
.idea/
log/
doc/
# 가이드/설계 문서는 저장소가 아니라 별도로 배포한다. superpowers 산출물도 여기 쌓이므로
# 디렉터리 전체를 제외한다. 파일은 워킹 트리에 그대로 남는다.
docs/
# 동등성 스냅샷은 로컬 산출물이다 (.gitkeep 은 남긴다)
tools/equivalence/out/*
!tools/equivalence/out/.gitkeep
tools/golden/out/*
!tools/golden/out/.gitkeep
hit.json
cbs_cache.json
package-lock.json
ss_ri_cache.json
conf.json
*.drawio
mobius.db*
test_*
.vscode/

# Claude Code (개인 설정/메모리)
.claude/
CLAUDE.md
.superpowers/

# 자격증명 — 저장소에 들어가면 안 된다
#
# 주의: ca-crt.pem / server-crt.pem / server-key.pem 은 이미 추적 중이라
# 아래 *.pem 규칙이 적용되지 않는다 (gitignore 는 추적되지 않는 파일에만 걸린다).
# 특히 server-key.pem 은 개인키인데 저장소에 들어가 있다 — 의도한 것인지
# 확인이 필요하다. 빼려면 git rm --cached 로 추적을 먼저 끊어야 한다.
id_ed25519*
id_rsa*
*.pem
*.key
*.ppk
